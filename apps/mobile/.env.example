# Copy to .env (or .env.local) in apps/mobile to override. Both are git-ignored.
# Every variable here is optional: leave it out and the app uses the default.
#
# EXPO_PUBLIC_ variables are built into the app, so anyone with the app can
# read them. Never put secrets here (passwords, API keys, JWT_SECRET).
# Restart Metro (npx expo start) after changing this file.

# Laluan Kitani API (apps/api).
# Default in development: http://<computer running Metro>:4000, so a phone or
# emulator on the same Wi-Fi reaches the API on your PC without any setup.
# Set it when the API runs elsewhere, e.g. a test server:
# EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_URL=

# Brunei map tiles (served by the "tiles" container in docker-compose.yml).
# Default in development: http://<computer running Metro>:8080/tiles/brunei.pmtiles
# EXPO_PUBLIC_TILES_URL=https://tiles.example.com/tiles/brunei.pmtiles
EXPO_PUBLIC_TILES_URL=
