{
  "expo": {
    "name": "Laluan Kitani",
    "slug": "laluankitani",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "laluankitani",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F9FAFB",
    "ios": {
      "bundleIdentifier": "com.polarisdigital.laluankitani",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "ms",
          "en"
        ]
      }
    },
    "android": {
      "package": "com.polarisdigital.laluankitani",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "ms": "./locales/ms.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Laluan Kitani uses your location for turn-by-turn directions and to warn you about reports on your route. Others only see it when you turn on Share trip."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ms",
              "en"
            ],
            "android": [
              "ms",
              "en"
            ]
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0F766E",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#1F2937"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0F766E"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "42e06ce5-95a8-4749-8fff-b1d4fb96db01"
      }
    },
    "owner": "polaris-digital-solutions"
  }
}
