{
  "name": "@laluankitani/api",
  "version": "0.1.0",
  "private": true,
  "description": "Laluan Kitani API: places, search, reports, Peak Spots and closures",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:reset": "node --env-file-if-exists=.env scripts/reset.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Polaris Digital Solution",
  "license": "UNLICENSED",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
