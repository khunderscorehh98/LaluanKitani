# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Matches docker-compose.yml at the repository root. Passwords never go in these URLs:
# the pg driver reads PGPASSWORD below.
DATABASE_URL=postgres://laluan@localhost:5433/laluankitani
TEST_DATABASE_URL=postgres://laluan@localhost:5433/laluankitani_test

# Same value as POSTGRES_PASSWORD in the root .env
PGPASSWORD=

# Signs sign-in tokens. Optional in development (a dev-only default is used);
# required in production: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# GraphHopper routing (docker compose service "routing"); this is the default
GRAPHHOPPER_URL=http://localhost:8989

# Comma-separated origins allowed by CORS (admin dashboard, website)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
